<h1>Log In</h1>

<%= form_with model: @user, url: session_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email, placeholder: 'Email', required: true %>
  </div>

  <div class="field">
    <%= f.label :password %>
    <%= f.password_field :password, placeholder: 'Password', required: true %>
  </div>

  <div class="actions">
    <%= f.submit 'Log In' %>
  </div>
<% end %>

<%= link_to("Forgot your password?", new_password_reset_path) %>
